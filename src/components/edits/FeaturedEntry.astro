---
// A featured index entry: set large, with question / method / outcome and a margin note.
// The default slot takes an optional figure (the Swift Harness gates).
import type { Work } from '../../data/site';

interface Props { work: Work; number: number; first?: boolean }
const { work, number, first = false } = Astro.props;
const fields = [
  ['Question', work.question],
  ['Method', work.method],
  ['Outcome', work.outcome],
].filter(([, v]) => v);
const external = work.href?.startsWith('http');
---
<li class:list={['featured', { first }]}>
  <span class="no mono">{String(number).padStart(2, '0')}</span>
  <span class="year mono">{work.year}</span>
  <div>
    <h3>
      {work.href ? <a href={work.href} rel={external ? 'noopener' : undefined}>{work.title}</a> : work.title}
      {external && <span class="out" aria-hidden="true">↗</span>}
    </h3>
    {work.credit && <p class="credit">{work.credit}</p>}
    {fields.length > 0 && (
      <dl>
        {fields.map(([k, v]) => (
          <>
            <dt class="label">{k}</dt>
            <dd>
              {v}
              {k === 'Outcome' && work.outcomeLink && (
                <> <a href={work.outcomeLink.href} rel="noopener">{work.outcomeLink.label}</a><span class="out-sm" aria-hidden="true">↗</span></>
              )}
            </dd>
          </>
        ))}
      </dl>
    )}
    {work.citation && (
      <p class="cite">
        <span class="label">Cite</span>
        <span>
          {work.citation}
          {work.doi && <> <a href={`https://doi.org/${work.doi}`}>doi.org/{work.doi}</a></>}
        </span>
      </p>
    )}
    <slot />
  </div>
  {work.note && (
    <p class="note">
      <span class="tag">MARGIN</span>
      <span class="note-text">{work.note}</span>
    </p>
  )}
</li>

<style>
  .featured {
    display: grid;
    grid-template-columns: 3ch 5ch minmax(0, 1fr) 230px;
    column-gap: 20px;
    align-items: start;
    padding: 32px 0 44px;
    border-top: 1px solid var(--rule);
  }
  .featured.first { border-top-color: var(--ink); }
  .no, .year { padding-top: 12px; font-size: 13px; }
  .year { color: var(--muted); }
  h3 {
    max-width: 22ch;
    font-weight: 400;
    font-size: clamp(1.75rem, 3.2vw, 2.5rem);
    line-height: 1.1;
    letter-spacing: -0.012em;
  }
  .out { margin-left: 0.2em; font-size: 0.55em; vertical-align: 0.4em; }
  .credit { margin-top: 10px; font-size: 15px; font-style: italic; color: var(--muted); }
  dl { display: grid; grid-template-columns: 96px minmax(0, 1fr); gap: 8px 18px; max-width: 44rem; margin-top: 24px; }
  dt { padding-top: 4px; }
  dd { font-size: 18px; text-wrap: pretty; }
  .out-sm { margin-left: 0.15em; font-size: 0.8em; }
  .cite {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr);
    gap: 18px;
    max-width: 44rem;
    margin-top: 16px;
    padding-top: 14px;
    border-top: 1px solid var(--rule);
    font-size: 15px;
    line-height: 1.45;
    color: var(--muted);
  }
  .cite .label { padding-top: 2px; }
  .cite a { color: var(--ink); overflow-wrap: anywhere; }
  .note { margin-top: 12px; }
  .note-text { display: block; margin-top: 8px; font-style: italic; font-size: 19px; line-height: 1.3; text-wrap: balance; }

  @media (max-width: 820px) {
    .featured { grid-template-columns: 3ch minmax(0, 1fr); }
    .year { display: none; }
    .note { grid-column: 2; margin-top: 20px; }
    dl { grid-template-columns: 1fr; gap: 2px; }
    dd { margin-bottom: 12px; }
    .cite { grid-template-columns: 1fr; gap: 4px; }
  }
</style>
