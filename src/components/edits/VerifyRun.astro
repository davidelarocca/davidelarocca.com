---
// A real end-of-turn check, not a mock-up: the verify script from Swift Harness 1.6.0, run on
// the design-system test package in the public repository (tests/fixtures/design-system),
// 7 November 2026. Lines are copied from the log; "⋮" marks lines left out, "…" a path cut short.
const lines: { text: string; kind?: 'step' | 'pass' | 'fail' | 'gap' | 'result' }[] = [
  { text: '$ scripts/verify.sh fast' },
  { text: '== swift test: Packages/DesignSystem ==', kind: 'step' },
  { text: '⋮', kind: 'gap' },
  { text: '✔ Suite "PillCenter" passed after 5.836 seconds.', kind: 'pass' },
  { text: '✘ Suite "PillView snapshots" failed after 5.836 seconds with 7 issues.', kind: 'fail' },
  { text: '⋮', kind: 'gap' },
  {
    text: 'PillView-error-macos-320-light: no approved baseline in …/snapshots. Show it to the user; only they approve it, with /swift-harness:approve-snapshots. Do not copy it into snapshots/ yourself.',
  },
  { text: '⋮', kind: 'gap' },
  { text: 'verify fast: FAIL (failed on: macOS)', kind: 'result' },
];
---
<figure class="run">
  <div class="bar">
    <span>Real run · excerpt</span>
    <span>swift-harness 1.6.0</span>
  </div>
  <pre><code>{lines.map((l) => <span class:list={['l', l.kind]}>{l.text}</span>)}</code></pre>
  <figcaption>
    The end-of-turn check on a test package from the public repository, 7 November 2026, shortened.
    The turn could not end: seven screenshots had no approved baseline, and only a person can approve one.
  </figcaption>
</figure>

<style>
  .run { max-width: 600px; margin-top: 28px; }
  .bar,
  pre {
    background: var(--ink);
    color: #e6e6e6;
    font-family: var(--mono);
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 2px 12px;
    padding: 10px 16px;
    border-bottom: 1px solid #2c2c2c;
    border-radius: 6px 6px 0 0;
    font-size: 12px;
    color: #a8a8a8;
  }
  .bar span { white-space: nowrap; }
  pre {
    margin: 0;
    padding: 14px 16px 18px;
    border-radius: 0 0 6px 6px;
    font-size: 13px;
    line-height: 1.6;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .l { display: block; }
  .l + .l { margin-top: 2px; }
  .step, .gap { color: #8f8f8f; }
  .pass { color: #e6e6e6; }
  .fail, .result { color: var(--accent-on-dark); }
  figcaption {
    margin-top: 10px;
    font-size: 15px;
    font-style: italic;
    line-height: 1.4;
    color: var(--muted);
    text-wrap: pretty;
  }

  @media (max-width: 820px) {
    pre { font-size: 12px; }
  }
</style>
