---
// The statement as an edited draft. Clichés are struck in the neon and numbered; each number
// has a one-line reason beside it. One button gives the clean copy.
// Screen readers get the clean sentence once, then the notes as a list.
import { person, editedStatement, editNotes } from '../../data/site';

const cuts = editedStatement.flat().filter((t) => t.kind === 'cut').length;
// Keep a cut's number on the same line as its last word.
const head = (text: string) => text.slice(0, text.lastIndexOf(' ') + 1);
const tail = (text: string) => text.slice(text.lastIndexOf(' ') + 1);
---
<section class="grid hero" aria-labelledby="statement" data-edits="shown">
  <div class="text">
    <h1 id="statement" class="statement">
      <span class="visually-hidden">{person.statement.join(' ')}</span>
      <span aria-hidden="true">
        {editedStatement.map((line) => (
          <span class="line">
            {line.map((t) => (
              <>
                <span class:list={['t', t.kind, t.voice]}>
                  {t.no ? (
                    <>
                      {head(t.text)}<span class="nowrap">{tail(t.text)}<sup>{t.no}</sup></span>
                    </>
                  ) : t.text}
                </span>{' '}
              </>
            ))}
          </span>
        ))}
      </span>
    </h1>
    <p class="controls" data-edit-controls hidden>
      <button type="button" class="toggle" data-edit-toggle>Hide the edits</button>
      <span class="count" data-edit-count>{cuts} cuts, {cuts} replacements</span>
    </p>
  </div>
  <ol class="notes" aria-label="Edit notes">
    {editNotes.map((n, i) => (
      <li><span class="no" aria-hidden="true">{i + 1}</span><span><span class="visually-hidden">Edit {i + 1}: </span>{n}</span></li>
    ))}
  </ol>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-edits]').forEach((hero) => {
    const controls = hero.querySelector<HTMLElement>('[data-edit-controls]')!;
    const button = hero.querySelector<HTMLButtonElement>('[data-edit-toggle]')!;
    const count = hero.querySelector<HTMLElement>('[data-edit-count]')!;
    const countText = count.textContent;
    controls.hidden = false;
    button.addEventListener('click', () => {
      const shown = hero.dataset.edits !== 'shown';
      hero.dataset.edits = shown ? 'shown' : 'clean';
      button.textContent = shown ? 'Hide the edits' : 'Show the edits';
      count.textContent = shown ? countText : 'clean copy';
    });
  });
</script>

<style>
  .hero { margin-top: clamp(64px, 10vw, 144px); align-items: start; }
  .text { grid-column: 1 / span 9; }
  .notes { grid-column: 10 / span 3; padding-top: 18px; }

  .statement {
    font-weight: 330;
    font-size: clamp(2.5rem, 5.6vw, 5rem);
    line-height: 1.18;
    letter-spacing: -0.02em;
    text-wrap: pretty;
  }
  .line { display: block; }
  .nowrap { white-space: nowrap; }
  @media (min-width: 821px) {
    .add.build { white-space: nowrap; }
  }
  .feel { font-family: var(--serif); font-style: italic; }
  .build { font-family: var(--mono); font-style: normal; font-size: 0.8em; letter-spacing: -0.035em; }
  .cut {
    color: #8a8a8a;
    text-decoration: line-through;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 0.09em;
  }
  sup {
    display: inline-grid;
    place-items: center;
    width: 1.6em;
    height: 1.6em;
    margin-left: 0.2em;
    border-radius: 50%;
    background: var(--accent);
    color: var(--on-accent);
    font-family: var(--mono);
    font-style: normal;
    font-size: clamp(10px, 0.2em, 16px);
    line-height: 1;
    letter-spacing: 0;
    vertical-align: 2.4em;
  }

  .controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 20px;
    margin-top: 36px;
    font-family: var(--mono);
    font-size: 13px;
  }
  .toggle {
    min-height: 44px;
    padding: 0 16px;
    border: 1px solid var(--ink);
    border-radius: 999px;
    background: var(--paper);
    cursor: pointer;
    font-family: var(--mono);
  }
  .toggle:hover { background: var(--ink); color: var(--paper); }
  .count { color: var(--muted); }

  .notes { font-family: var(--mono); font-size: 13px; line-height: 1.5; }
  .notes li { display: grid; grid-template-columns: 26px minmax(0, 1fr); gap: 10px; padding-bottom: 18px; }
  .no {
    display: inline-grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--accent);
    color: var(--on-accent);
    font-size: 11px;
  }

  /* Clean copy: the cuts and their notes disappear. */
  [data-edits='clean'] .cut { display: none; }
  /* Without the notes the statement takes the full width, so "I build what comes next." stays on one line. */
  [data-edits='clean'] .text { grid-column: 1 / -1; }
  [data-edits='clean'] .notes { display: none; }

  @media (max-width: 820px) {
    .text, .notes { grid-column: 1 / -1; }
    .notes { margin-top: 28px; padding-top: 0; }
  }
</style>
