---
// A quiet index entry: number, year, title, credit and kind.
import type { Work } from '../../data/site';

interface Props { work: Work; number: number }
const { work, number } = Astro.props;
const external = work.href?.startsWith('http');
---
<li class="row">
  <span class="no mono">{String(number).padStart(2, '0')}</span>
  <span class="year mono">{work.year}</span>
  <div>
    <h3>
      {work.href ? <a href={work.href} rel={external ? 'noopener' : undefined}>{work.title}</a> : work.title}
      {external && <span class="out" aria-hidden="true">↗</span>}
    </h3>
    {work.credit && <p class="credit">{work.credit}</p>}
  </div>
  <span class="kind mono">{work.kind.toLowerCase()}</span>
</li>

<style>
  .row {
    display: grid;
    grid-template-columns: 3ch 5ch minmax(0, 1fr) 9rem;
    column-gap: 20px;
    align-items: baseline;
    padding: 18px 0 20px;
    border-top: 1px solid var(--rule);
  }
  .no, .year, .kind { font-size: 13px; color: var(--muted); }
  .kind { font-size: 12px; text-align: right; }
  h3 { font-weight: 400; font-size: 21px; line-height: 1.25; }
  .out { margin-left: 0.2em; font-size: 0.7em; vertical-align: 0.25em; }
  .credit { margin-top: 4px; font-size: 15px; font-style: italic; color: var(--muted); }

  @media (max-width: 820px) {
    .row { grid-template-columns: 3ch minmax(0, 1fr) auto; }
    .year { order: 3; }
    .kind { display: none; }
  }
</style>
