---
// Secondary page: professional background and CV, kept as a log of positions held.
import Base from '../layouts/Base.astro';
import { person } from '../data/site';

const roles = [
  { years: '2023 —', role: 'Marketing & Communication Manager', org: 'Costa Cruises', note: 'Onboard communication and guest experience reaching 5,500+ guests.' },
  { years: '2018 — 2023', role: 'Study Abroad Program Manager', org: 'San Marino Tourservice', note: 'International programmes with King’s College London, Imperial College London, University of Liverpool.' },
  { years: '2021 — 2022', role: 'Project Manager', org: 'Biolaser / BiosMed', note: 'HR automation and internal systems; 10× applicants in six months.' },
  { years: '2020 — 2021', role: 'Marketing & Communication Manager', org: 'TuliPark', note: '+43% revenue year on year; CSR initiative recognised by the President of Emilia-Romagna.' },
  { years: '2017 — 2018', role: 'Senior Associate', org: 'Amazon', note: 'B2B relations with premium vendors.' },
  { years: '2016', role: 'Product Management', org: 'TOD’S Group', note: '' },
];
const education = [
  { years: '2023 — 2024', what: 'Executive Master, Institutional Marketing and Communication', where: 'LUISS School of Government' },
  { years: '2018 — 2019', what: 'MSc International Marketing & Brand Management', where: 'Lund University' },
  { years: '2014 — 2017', what: 'MA Fashion, Culture and Management', where: 'University of Bologna' },
  { years: '2011 — 2014', what: 'BA International Relations and Diplomatic Affairs', where: 'University of Bologna' },
];
---
<Base title="Background & CV" description={`Background and CV of ${person.name}. ${person.bio}`}>
  <main id="main">
    <h1>Background</h1>
    <p class="lead">{person.bio} Italian, English, French, Spanish.</p>

    <section aria-labelledby="work">
      <h2 id="work">WORK</h2>
      <ol>
        {roles.map((r) => (
          <li class="row">
            <span class="years">{r.years}</span>
            <div><h3>{r.role}</h3><p class="org">{r.org}</p>{r.note && <p class="note">{r.note}</p>}</div>
          </li>
        ))}
      </ol>
    </section>

    <section aria-labelledby="education">
      <h2 id="education">EDUCATION</h2>
      <ol>
        {education.map((e) => (
          <li class="row">
            <span class="years">{e.years}</span>
            <div><h3>{e.what}</h3><p class="org">{e.where}</p></div>
          </li>
        ))}
      </ol>
    </section>
  </main>
</Base>
<style>
  h1 { margin-top: clamp(64px, 10vw, 144px); font-weight: 330; font-style: italic; font-size: clamp(2.5rem, 6vw, 4rem); line-height: 1.05; letter-spacing: -0.015em; }
  .lead { margin-top: 24px; max-width: 36em; font-size: 20px; }
  section { margin-top: 88px; }
  h2 { padding-bottom: 8px; border-bottom: 1px solid var(--ink); font-family: var(--mono); font-size: 13px; font-weight: 400; letter-spacing: 0.04em; }
  .row { display: grid; grid-template-columns: 130px minmax(0, 1fr); column-gap: 24px; align-items: baseline; padding: 18px 0; border-bottom: 1px solid var(--rule); }
  .years { font-family: var(--mono); font-size: 13px; font-variant-numeric: tabular-nums; }
  h3 { font-weight: 400; font-size: 21px; line-height: 1.3; }
  .org { margin-top: 2px; font-style: italic; color: var(--muted); }
  .note { margin-top: 6px; max-width: 40em; }
  @media (max-width: 820px) {
    .row { grid-template-columns: 1fr; row-gap: 4px; }
  }
</style>
